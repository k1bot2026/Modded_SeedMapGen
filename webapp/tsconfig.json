{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "noEmit": true,
    "declaration": false,
    "sourceMap": false,
    "useDefineForClassFields": true
  },
  "include": ["src", "test", "e2e", "mock", "vite.config.ts", "playwright.config.ts"]
}
