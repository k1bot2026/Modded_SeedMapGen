{
  "name": "@seedmap/webapp",
  "version": "0.1.0",
  "private": true,
  "description": "Vite + TypeScript + MapLibre GL slippy map over the seedmap oracle: biome tiles, structure markers grouped by namespace, dimension switcher, search, shareable URLs.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "mock": "node mock/mock-oracle.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vite build && playwright test",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "maplibre-gl": "^5.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@playwright/test": "~1.56.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.15.0",
    "eslint": "^9.30.0",
    "globals": "^16.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.35.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
